NODE_ENV=development
# macOS Control Center / AirPlay Receiver already listens on 5000 and returns HTTP 403.
PORT=5050

MONGODB_URI=mongodb://127.0.0.1:27017/md_ai_office

JWT_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000

LOG_LEVEL=info
APP_TIMEZONE=Asia/Kolkata

MAYTAPI_TOKEN=
MAYTAPI_PRODUCT_ID=
MAYTAPI_PHONE_ID=
MAYTAPI_WEBHOOK_SECRET=

WHATSAPP_PROVIDER=meta
WHATSAPP_VERIFY_TOKEN=change_this_whatsapp_verify_token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=change_this_whatsapp_app_secret
WHATSAPP_API_VERSION=v21.0
WHATSAPP_MESSAGE_TIMEOUT_MS=10000
WHATSAPP_MAX_RETRIES=3
WHATSAPP_WORKER_INTERVAL_MS=2000
WHATSAPP_LINK_CODE_TTL_MS=600000

SWAGGER_ENABLED=true
SWAGGER_SERVER_URL=http://localhost:5050

# ===== MULTI-AI PROVIDER CONFIGURATION =====
# Add your API keys below. System will auto-fallback in priority order.
# When one provider fails (rate limit, error, timeout), it tries the next one.

# --- Primary: Gemini (Google) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=8000

# --- Backup 1: Grok (xAI) ---
GROK_API_KEY=
GROK_MODEL=grok-3
GROK_TIMEOUT_MS=10000

# --- Backup 2: OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=10000

# --- Backup 3: Z AI (ZhipuAI / OpenAI-compatible) ---
Z_AI_API_KEY=
Z_AI_MODEL=default
Z_AI_TIMEOUT_MS=10000
# Z_AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4  # Optional: Custom endpoint

# --- Backup 4: Claude (Anthropic) ---
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_TIMEOUT_MS=10000

# ===== Multi-AI Fallback Settings =====
# Provider priority order (comma-separated, tried left-to-right)
AI_PROVIDERS_PRIORITY=gemini,grok,openai,z_ai,claude

# Response language: en (English), ta (Tamil), auto (detect)
AI_RESPONSE_LANGUAGE=en

# Enable automatic fallback when a provider fails (true/false)
AI_FALLBACK_ENABLED=true

# Maximum number of providers to try before giving up
AI_MAX_RETRIES=3

# Automated tests use MongoMemoryServer. .env.test documents ai_md_test.
# Performance jobs must use a database whose name contains "performance".
# PERF_MONGODB_URI=mongodb://127.0.0.1:27017/ai_md_performance
# PERF_SCALE=small
