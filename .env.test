NODE_ENV=test
PORT=5050

# Automated Jest suites use MongoMemoryServer (see tests/helpers.ts).
# This URI documents the dedicated integration-test database if a runner
# is pointed at a real MongoDB. Never use production or the developer DB.
MONGODB_URI=mongodb://127.0.0.1:27017/ai_md_test

JWT_SECRET=test_access_secret_do_not_use_elsewhere
JWT_REFRESH_SECRET=test_refresh_secret_do_not_use_elsewhere
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=fatal
APP_TIMEZONE=Asia/Kolkata

WHATSAPP_PROVIDER=meta
WHATSAPP_VERIFY_TOKEN=whatsapp-verify-test
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=whatsapp-secret-test
WHATSAPP_API_VERSION=v21.0

SWAGGER_ENABLED=true
SWAGGER_SERVER_URL=http://localhost:5000
