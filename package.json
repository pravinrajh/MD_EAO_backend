{
  "name": "aibot-backend",
  "version": "1.0.0",
  "description": "AI Executive Office / MD Management System API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "test": "NODE_ENV=test jest --runInBand --forceExit",
    "test:unit": "NODE_ENV=test jest --runInBand --forceExit tests/unit",
    "test:integration": "NODE_ENV=test jest --runInBand --forceExit --testPathIgnorePatterns=/tests/unit/ --testPathIgnorePatterns=/tests/e2e/",
    "test:e2e": "NODE_ENV=test jest --runInBand --forceExit tests/e2e",
    "test:security": "NODE_ENV=test jest --runInBand --forceExit tests/security.test.ts tests/auth.test.ts tests/concurrency.test.ts",
    "test:coverage": "NODE_ENV=test jest --runInBand --forceExit --coverage --json --outputFile=test-report/integration-results.json",
    "test:performance": "tsx scripts/run-performance-suite.ts",
    "swagger:validate": "tsx scripts/swagger-validate.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "seed:performance": "tsx scripts/seed-performance.ts",
    "perf:explain": "tsx scripts/explain-queries.ts",
    "perf:cleanup": "tsx scripts/cleanup-performance.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
